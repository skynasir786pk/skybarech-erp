{
  "name": "skybarech-mobile-shop-erp-desktop",
  "version": "1.3.28",
  "author": "SkyBarech Technology",
  "description": "SkyBarech Mobile Shop ERP desktop application.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.skybarech.mobileshoperp",
    "productName": "SkyBarech ERP",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/prebuilds/**/*.node"
    ],
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "SkyBarech-ERP-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SkyBarech ERP",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  }
}
